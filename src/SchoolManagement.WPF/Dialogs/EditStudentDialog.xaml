<Window x:Class="SchoolManagement.WPF.Dialogs.EditStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش شاگرد" Height="500" Width="420"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer Margin="20">
        <StackPanel>
            <TextBlock Text="نام کامل"/>
            <TextBox x:Name="FullNameBox" Height="30" Margin="0,4,0,12"/>

            <TextBlock Text="نام پدر"/>
            <TextBox x:Name="FatherNameBox" Height="30" Margin="0,4,0,12"/>

            <TextBlock Text="آدرس"/>
            <TextBox x:Name="AddressBox" Height="30" Margin="0,4,0,12"/>

            <TextBlock Text="صنف"/>
            <ComboBox x:Name="ClassCombo" Height="30" Margin="0,4,0,12" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Text="وضعیت"/>
            <ComboBox x:Name="StatusCombo" Height="30" Margin="0,4,0,12">
                <ComboBoxItem Content="فعال" Tag="Active"/>
                <ComboBoxItem Content="معلق" Tag="Suspended"/>
                <ComboBoxItem Content="ترک تحصیل" Tag="Withdrawn"/>
                <ComboBoxItem Content="فارغ‌التحصیل" Tag="Graduated"/>
                <ComboBoxItem Content="اخراج" Tag="Expelled"/>
            </ComboBox>

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <Button x:Name="SaveButton" Content="ذخیره تغییرات" Height="36" Click="SaveButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
