<Window x:Class="SchoolManagement.WPF.Dialogs.RecordPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت پرداخت" Height="500" Width="480"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StudentNameText" FontSize="18" FontWeight="Bold"/>

        <DataGrid Grid.Row="2" x:Name="InvoicesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionChanged="InvoicesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="150"/>
                <DataGridTextColumn Header="باقی‌مانده" Binding="{Binding Balance, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="مبلغ پرداختی"/>
        <TextBox Grid.Row="5" x:Name="AmountBox" Height="30" Margin="0,4,0,0"/>

        <TextBlock Grid.Row="7" Text="روش پرداخت"/>
        <ComboBox Grid.Row="8" x:Name="MethodCombo" Height="30" Margin="0,4,0,0">
            <ComboBoxItem Content="نقد" Tag="Cash" IsSelected="True"/>
            <ComboBoxItem Content="حواله بانکی" Tag="BankTransfer"/>
            <ComboBoxItem Content="موبایل مانی" Tag="MobileWallet"/>
            <ComboBoxItem Content="چک" Tag="Cheque"/>
        </ComboBox>

        <TextBlock Grid.Row="10" Text="توضیحات (اختیاری)"/>
        <TextBox Grid.Row="10" x:Name="NoteBox" Height="30" Margin="120,0,0,0" HorizontalAlignment="Stretch"/>

        <TextBlock Grid.Row="12" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button Grid.Row="14" x:Name="SaveButton" Content="ثبت پرداخت و صدور رسید" Height="38" Click="SaveButton_Click"/>
    </Grid>
</Window>
