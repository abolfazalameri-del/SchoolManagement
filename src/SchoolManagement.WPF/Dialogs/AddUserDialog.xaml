<Window x:Class="SchoolManagement.WPF.Dialogs.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="افزودن کاربر جدید" Height="420" Width="380"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="نام کاربری (برای ورود)"/>
        <TextBox x:Name="UsernameBox" Height="30" Margin="0,4,0,12"/>

        <TextBlock Text="نام کامل"/>
        <TextBox x:Name="FullNameBox" Height="30" Margin="0,4,0,12"/>

        <TextBlock Text="نقش"/>
        <ComboBox x:Name="RoleCombo" Height="30" Margin="0,4,0,12">
            <ComboBoxItem Content="مدیر مکتب" Tag="Administrator"/>
            <ComboBoxItem Content="محاسب" Tag="Accountant" IsSelected="True"/>
            <ComboBoxItem Content="منشی" Tag="Registrar"/>
            <ComboBoxItem Content="معلم" Tag="Teacher"/>
        </ComboBox>

        <TextBlock Text="رمز عبور موقت (حداقل ۶ کاراکتر)"/>
        <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,4,0,12"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

        <Button x:Name="SaveButton" Content="ایجاد کاربر" Height="36" Click="SaveButton_Click"/>
    </StackPanel>
</Window>
