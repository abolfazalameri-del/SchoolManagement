<Window x:Class="SchoolManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سیستم مدیریت مکتب خصوصی"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="14"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#1F2937">
            <StackPanel>
                <TextBlock Text="مکتب خصوصی" Foreground="White" FontSize="18" FontWeight="Bold" Margin="16,20,16,4"/>
                <TextBlock x:Name="CurrentUserText" Foreground="#9CA3AF" FontSize="12" Margin="16,0,16,20"/>

                <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Foreground="White" Content="🏠 داشبورد" Click="NavDashboard_Click"/>
                <Button x:Name="NavClasses" Style="{StaticResource NavButton}" Foreground="White" Content="🏫 صنوف" Click="NavClasses_Click"/>
                <Button x:Name="NavStudents" Style="{StaticResource NavButton}" Foreground="White" Content="🎓 شاگردان" Click="NavStudents_Click"/>
                <Button x:Name="NavAttendance" Style="{StaticResource NavButton}" Foreground="White" Content="📋 حاضری" Click="NavAttendance_Click"/>
                <Button x:Name="NavFees" Style="{StaticResource NavButton}" Foreground="White" Content="💰 فیس و بدهکاران" Click="NavFees_Click"/>
                <Button x:Name="NavUsers" Style="{StaticResource NavButton}" Foreground="White" Content="👤 کاربران" Click="NavUsers_Click"/>

                <Separator Margin="16,16"/>
                <Button x:Name="NavLogout" Style="{StaticResource NavButton}" Foreground="#F87171" Content="⎋ خروج از سیستم" Click="NavLogout_Click"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Border Grid.Column="1" Background="#F9FAFB">
            <ContentControl x:Name="MainContent" Margin="24"/>
        </Border>
    </Grid>
</Window>
