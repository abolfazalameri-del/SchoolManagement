<UserControl x:Class="SchoolManagement.WPF.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="کاربران سیستم" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="➕ افزودن کاربر جدید" Padding="12,6" Click="AddButton_Click"/>
            <Button DockPanel.Dock="Right" Content="فعال/غیرفعال کردن انتخاب‌شده" Padding="12,6" Margin="0,0,8,0" Click="ToggleActiveButton_Click"/>
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نام کاربری" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="نام کامل" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="نقش" Binding="{Binding Role}" Width="120"/>
                <DataGridTextColumn Header="فعال" Binding="{Binding IsActive}" Width="80"/>
                <DataGridTextColumn Header="آخرین ورود" Binding="{Binding LastLoginAtUtc}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
