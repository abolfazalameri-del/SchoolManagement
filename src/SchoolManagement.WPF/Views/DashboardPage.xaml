<UserControl x:Class="SchoolManagement.WPF.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="داشبورد" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <UniformGrid Columns="3" Rows="2">
            <Border Background="White" CornerRadius="8" Margin="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="شاگردان فعال" Opacity="0.6"/>
                    <TextBlock x:Name="StudentsText" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="استادان فعال" Opacity="0.6"/>
                    <TextBlock x:Name="TeachersText" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="تعداد صنوف" Opacity="0.6"/>
                    <TextBlock x:Name="ClassesText" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="حضور امروز" Opacity="0.6"/>
                    <TextBlock x:Name="AttendanceText" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="فیس جمع‌شده این ماه" Opacity="0.6"/>
                    <TextBlock x:Name="FeesText" Text="—" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="بدهی معوقه کل" Opacity="0.6"/>
                    <TextBlock x:Name="DebtText" Text="—" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,20,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
