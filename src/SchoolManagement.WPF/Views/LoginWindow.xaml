<Window x:Class="SchoolManagement.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سیستم" Height="420" Width="380"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="سیستم مدیریت مکتب خصوصی" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="نام کاربری"/>
        <TextBox Grid.Row="3" x:Name="UsernameBox" Height="32" Padding="6" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Text="رمز عبور"/>
        <PasswordBox Grid.Row="5" x:Name="PasswordBox" Height="32" Padding="6" VerticalContentAlignment="Center" KeyDown="PasswordBox_KeyDown"/>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button Grid.Row="8" x:Name="LoginButton" Content="ورود" Height="36" Click="LoginButton_Click"/>

        <TextBlock Grid.Row="10" Text="در اولین اجرا، نام کاربری admin ساخته می‌شود و رمز موقت در پوشه داده برنامه ذخیره خواهد شد." Opacity="0.5" FontSize="11" HorizontalAlignment="Center"/>
    </Grid>
</Window>
