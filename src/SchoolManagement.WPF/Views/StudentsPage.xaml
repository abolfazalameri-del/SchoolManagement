<UserControl x:Class="SchoolManagement.WPF.Views.StudentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="شاگردان" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="AddButton" Content="➕ افزودن شاگرد جدید" Padding="12,6" Click="AddButton_Click"/>
            <Button DockPanel.Dock="Right" Content="جستجو" Padding="12,6" Margin="0,0,8,0" Click="SearchButton_Click"/>
            <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" MouseDoubleClick="StudentsGrid_MouseDoubleClick" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره" Binding="{Binding StudentNumber}" Width="100"/>
                <DataGridTextColumn Header="نام کامل" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="نام پدر" Binding="{Binding FatherName}" Width="150"/>
                <DataGridTextColumn Header="صنف" Binding="{Binding SchoolClassName}" Width="150"/>
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
